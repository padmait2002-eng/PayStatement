{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "newProjectRoot": "projects",
  "projects": {
    "paystatement-angular": {
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "outputPath": "dist/paystatement-angular",
            "polyfills": [
              "zone.js"
            ],
            "styles": [
              "src/styles.css"
            ],
            "tsConfig": "tsconfig.app.json"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "paystatement-angular:build:development"
            },
            "production": {
              "buildTarget": "paystatement-angular:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      },
      "projectType": "application",
      "root": "",
      "sourceRoot": "src"
    }
  },
  "version": 1
}
